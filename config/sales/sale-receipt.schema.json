{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://300x3.example/schemas/corda-sale-receipt-v1.json",
  "title": "Corda-managed sale receipt record",
  "type": "object",
  "additionalProperties": false,
  "required": ["transaction_id", "correlation_id", "receipt_number", "event_timestamp_utc", "order_id", "customer_reference", "sku", "serial_number", "payment_reference", "corda_event_type", "schema_version", "corda_state", "sale_request_evidence", "payment_validation_evidence", "funds_transfer_evidence"],
  "properties": {
    "transaction_id": {"type": "string", "pattern": "^TXN-[0-9]{8}T[0-9]{6}Z-[A-F0-9]{12}$"},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "receipt_number": {"type": "string", "minLength": 1, "maxLength": 160},
    "event_timestamp_utc": {"type": "string", "format": "date-time"},
    "order_id": {"type": "string", "format": "uuid"},
    "customer_reference": {"type": "string", "minLength": 1, "maxLength": 160},
    "sku": {"type": "string", "minLength": 1, "maxLength": 160},
    "product_name": {"type": "string", "maxLength": 300},
    "serial_number": {"type": "string", "minLength": 1, "maxLength": 160},
    "quantity": {"type": "integer", "minimum": 1, "default": 1},
    "unit_price_cents": {"type": "integer", "minimum": 0},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$", "default": "USD"},
    "payment_provider": {"type": "string", "maxLength": 100},
    "payment_reference": {"type": "string", "minLength": 1, "maxLength": 256},
    "payment_state": {"enum": ["pending", "validated", "settled", "failed", "refunded"]},
    "sale_request_evidence": {"type": "object", "required": ["status", "source_reference", "content_hash_sha256"], "properties": {"status": {"enum": ["received", "validated", "rejected", "superseded"]}, "source_reference": {"type": "string"}, "content_hash_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false},
    "payment_validation_evidence": {"type": "object", "required": ["status", "provider", "source_reference", "content_hash_sha256"], "properties": {"status": {"enum": ["received", "validated", "rejected", "superseded"]}, "provider": {"enum": ["paypal", "Zelle", "coinbase", "bank", "manual_reconciliation"]}, "source_reference": {"type": "string"}, "content_hash_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false},
    "funds_transfer_evidence": {"type": "object", "required": ["status", "source_reference", "settled_at_utc", "content_hash_sha256"], "properties": {"status": {"enum": ["received", "validated", "rejected", "superseded"]}, "source_reference": {"type": "string"}, "settled_at_utc": {"type": "string", "format": "date-time"}, "content_hash_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false},
    "corda_event_type": {"enum": ["SALE_CONTRACT_CREATED", "ENTITLEMENT_ISSUED", "ENTITLEMENT_REVOKED", "FULFILLMENT_APPROVED", "DELIVERY_CONFIRMED", "RETURN_APPROVED", "REFUND_RECORDED"]},
    "corda_transaction_id": {"type": ["string", "null"], "maxLength": 256},
    "corda_state": {"enum": ["PENDING_SUBMISSION", "SUBMITTED", "CONFIRMED", "REJECTED", "FAILED"]},
    "authorized_by": {"type": "string", "minLength": 1, "maxLength": 160},
    "authorization_reference": {"type": "string", "maxLength": 256},
    "notes": {"type": "string", "maxLength": 4000},
    "schema_version": {"const": "1.0"}
  }
}
