# ALWAYS ON - ao-grafana non-secret settings.
#
# This file deliberately contains NO passwords, tokens or keys. It is safe to
# track in Git. The Grafana admin password lives only in KDE Wallet
# (ao-admin/grafana-admin-password) and is materialised 0600 into
# %h/.local/share/ao-secrets/reporting-grafana-admin.env by the unit's
# ExecStartPre. See README 4.1 rule 7 and section 14.1.1.
#
# Replaces the former config/platform/monitoring/grafana.env, which held a
# cleartext admin password at mode 0664.
GF_SECURITY_ADMIN_USER=ao-admin
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false

# frser-sqlite-datasource is required for the SQLite reporting panels. The
# plugin is UNSIGNED (no signature and no signedByOrg in its plugin.json,
# verified 2026-10-03), so Grafana refuses to load it unless it is named here.
# The value is a comma-separated allow-list naming this ONE plugin id -- it is
# deliberately not "*". This is an approved deviation from README 6.A.3 and is
# recorded in section 19.2: a third-party unsigned plugin reaches the Grafana
# process, so it is pinned to a reviewed copy under
# /ALWAYSON/data/monitoring/grafana-plugins rather than pulled at start-up.
GF_PLUGINS_ALLOW_LOADING_UNSIGNED_PLUGINS=frser-sqlite-datasource
