# ALWAYS ON - ao-grafana non-secret settings.
#
# This file deliberately contains NO passwords, tokens or keys. It is safe to
# track in Git. The Grafana admin password lives only in KDE Wallet
# (ao-admin/grafana-admin-password) and is materialised 0600 into
# %h/.local/share/ao-secrets/reporting-grafana-admin.env by the unit's
# ExecStartPre. See README 4.1 rule 7 and section 14.1.1.
#
# Replaces the former config/platform/monitoring/grafana.env, which held a
# cleartext admin password at mode 0664.
GF_SECURITY_ADMIN_USER=ao-admin
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false
