# ALWAYS ON Mastodon - local instance environment (TEMPLATE, NO SECRETS).
# Copy to /ALWAYSON/secrets/mastodon/mastodon.env (gitignored) and fill values,
# or run scripts/mastodon/deploy-mastodon.sh -g to generate them automatically.
# Secrets are mirrored into KDE Wallet under ao-mastodon for operator access.

# --- identity (local only) ---
LOCAL_DOMAIN=300x3
SINGLE_USER_MODE=false
DEFAULT_LOCALE=en

# --- application keys (REQUIRED; >128-bit) ---
# SECRET_KEY_BASE, OTP_SECRET and POSTGRES password are generated at deploy time.

# --- database (container mastodon-db) ---
DB_host=mastodon-db
DB_USER=mastodon
DB_NAME=mastodon
POSTGRES_DB=mastodon
POSTGRES_USER=mastodon
# POSTGRES_PASSWORD: set at deploy time (not in template)

# --- redis (container mastodon-redis) ---
REDIS_HOST=mastodon-redis
REDIS_PORT=6379

# --- concurrency ---
WEB_CONCURRENCY=2
MAX_THREADS=5
STREAMING_CLUSTER_NUM=1

# --- ES/optimization (off by default for a tiny local instance) ---
ES_ENABLED=false

# --- smtp: none (local); operator uses Tokodon directly ---
# loopback-only local instance: never force HTTPS on 127.0.0.1 (ISSUE 000600)
RAILS_FORCE_SSL=false
LOCAL_HTTPS=false
