<?xml version="1.0"?>
<model>
  <name>factory_assets</name>
  <version>1.0</version>
  <sdf version="1.11">model.sdf</sdf>
  <author>
    <name>ALWAYSON</name>
    <email>operator@localhost</email>
  </author>
  <description>
    Static factory set assembled from four in-place SketchUp exports
    (inch units, Z-up, shared aligned coordinate frame):
      - building massing + ADU doors / fabrication area
      - conveyor system
      - robot arms
      - vehicles + arms overlay (lifted +2.5 m; see model.sdf note)
    Meshes live in meshes/ as symlinks to /ALWAYSON/GAZEBO/*.dae so the
    original exports are never copied or modified.
  </description>
</model>
