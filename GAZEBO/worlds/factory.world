<?xml version="1.0" ?>
<!--
  factory.world — canonical Gazebo Sim entry point combining all four SketchUp
  exports (README §10.2: "scripted and repeatable from a single entry point, so
  the world rebuilds identically on any host").

  CANONICAL LOCATION: /ALWAYSON/GAZEBO/worlds/factory.world — the Gazebo
  subfolder required by README §10.2 (line 2005). This is the single source of
  truth for the world; the domain mount is read-only and holds no copy.

  LAUNCH (host):
    GZ_SIM_RESOURCE_PATH=/ALWAYSON/GAZEBO/models \
      gazebo /ALWAYSON/GAZEBO/worlds/factory.world

  LAUNCH (container, Quadlet ao-sim-fabrication-gz.container):
    The unit mounts /ALWAYSON/GAZEBO read-only at the SAME path and sets
    GZ_SIM_RESOURCE_PATH=/ALWAYSON/GAZEBO/models, so the model:// URIs below
    resolve identically inside and outside the container and the meshes/
    symlinks (absolute targets under /ALWAYSON/GAZEBO) still resolve.

  MESH URIs: model://factory_assets/meshes/*.dae resolved through
  GZ_SIM_RESOURCE_PATH, per README §10.2 line 2002 and §10.1 line 1842 —
  never fetched or rewritten at runtime. The mesh files are symlinks under
  ../models/factory_assets/meshes/ pointing at the four original exports in
  /ALWAYSON/GAZEBO/, which are never copied or modified (massing_fab.dae is
  the alias for the newline-leading filename).

  WHY SUN + GROUND ARE INLINED: this host has no Fuel model cache shipping
  sun/ground_plane, so inlining keeps the world loadable as a single entry
  point with no network fetch. The reusable model artifact carrying the same
  four links is ../models/factory_assets/model.sdf (+ model.config).

  SOURCE DATA (all inch, Z_UP, shared aligned frame; scale 0.0254):
    building_massing  <- "\n09-SIMULATIONMASSING-ADUDOORS_FABRICATIONAREA.dae"
    conveyor_system   <- 09-SIMULATIONCONVEYOR.dae
    robot_arms        <- 09-SIMULATIONARMS.dae
    vehicles_overlay  <- 09-SIMULATIONVEHICLES-ARMS.dae, LIFTED +2.5 m
      (deliberate, operator-visible: it duplicates arms/vehicles content, so
       it sits at pose 0 0 2.5 to stay inspectable; set to 0 0 0 for exact
       in-place overlay)

  NOT YET (README baseline, tracked WORK 000800/ST-07 and WORK 000801/ST-08):
    per-cell datum/boning frames, RL objects, HTML portal, safety zones.
-->
<sdf version="1.11">
  <world name="factory">

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <physics name="default_physics" default="0" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000.0</real_time_update_rate>
    </physics>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="factory">
      <static>true</static>

      <link name="building_massing">
        <pose>0 0 0 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://factory_assets/meshes/massing_fab.dae</uri>
              <scale>0.0254 0.0254 0.0254</scale>
            </mesh>
          </geometry>
        </visual>
        <collision name="collision">
          <pose>3.937000 2.415536 1.028700 0 0 0</pose>
          <geometry>
            <box><size>7.874000 4.831072 2.057400</size></box>
          </geometry>
        </collision>
      </link>

      <link name="conveyor_system">
        <pose>0 0 0 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://factory_assets/meshes/conveyor.dae</uri>
              <scale>0.0254 0.0254 0.0254</scale>
            </mesh>
          </geometry>
        </visual>
        <collision name="collision">
          <pose>6.072981 2.337311 1.028700 0 0 0</pose>
          <geometry>
            <box><size>1.747837 1.127674 2.032000</size></box>
          </geometry>
        </collision>
      </link>

      <link name="robot_arms">
        <pose>0 0 0 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://factory_assets/meshes/arms.dae</uri>
              <scale>0.0254 0.0254 0.0254</scale>
            </mesh>
          </geometry>
        </visual>
        <collision name="collision">
          <pose>6.401314 2.697865 1.150797 0 0 0</pose>
          <geometry>
            <box><size>0.840000 1.672391 1.238532</size></box>
          </geometry>
        </collision>
      </link>

      <link name="vehicles_overlay">
        <pose>0 0 2.5 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://factory_assets/meshes/vehicles_arms.dae</uri>
              <scale>0.0254 0.0254 0.0254</scale>
            </mesh>
          </geometry>
        </visual>
        <collision name="collision">
          <pose>3.873492 0.512019 0.725369 0 0 0</pose>
          <geometry>
            <box><size>4.537352 0.918508 1.450042</size></box>
          </geometry>
        </collision>
      </link>

    </model>

  </world>
</sdf>
