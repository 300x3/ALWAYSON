digraph alwayson_databases {
  graph [rankdir=TB, compound=true, newrank=true, fontname="DejaVu Sans", fontsize=11, bgcolor="#ffffff", nodesep=0.45, ranksep=0.75, splines=spline, pad=0.4, labelloc=t, fontsize=22, label=<<b>ALWAYS ON &mdash; DATABASES &amp; DATA STORES</b><br/><font point-size="11">v6 3.3 / 3.3.1 Program-to-Database Map &mdash; authority, placement, status, and the programs that use each store</font><br/><font point-size="10">generated 2026-10-03T19:52:47Z &mdash; PostgreSQL 18 is the system-wide relational platform; Redis is not a system of record; SQLite and H2 are not approved application databases for Grafana or Metabase</font>>];
  node [shape=box, fontname="DejaVu Sans", fontsize=10, margin="0.16,0.10"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#607d8b", arrowsize=0.7];
  n_legend [shape=note, fillcolor="#ffffff", color="#455a64", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD COLSPAN="2"><B>LEGEND &mdash; authority and status</B></TD></TR><TR><TD><FONT COLOR="#1b5e20">&#9632;</FONT></TD><TD><FONT POINT-SIZE="9">AUTHORITATIVE RELATIONAL</FONT></TD></TR><TR><TD><FONT COLOR="#f57f17">&#9632;</FONT></TD><TD><FONT POINT-SIZE="9">AUTHORITATIVE LEDGER</FONT></TD></TR><TR><TD><FONT COLOR="#546e7a">&#9632;</FONT></TD><TD><FONT POINT-SIZE="9">NOT AUTHORITATIVE</FONT></TD></TR><TR><TD><FONT COLOR="#b71c1c">&#9632;</FONT></TD><TD><FONT POINT-SIZE="9">NOT AN APPROVED APPLICATION DB</FONT></TD></TR></TABLE>>];
  subgraph cluster_db_n_postgis {
    label=<<b>PostgreSQL / PostGIS 3.6.2</b> <font point-size="9">(1)</font>>; style="rounded,filled"; fillcolor="#fafbfd"; color="#7986cb"; fontsize=12;
    n_db_webodm [shape=box, style="rounded,filled", fillcolor="#c8e6c9", color="#1b5e20", penwidth=1.5, label=<<b>webodm (PostGIS)</b><br/><font color='#0d47a1'>PostgreSQL/PostGIS (in container-scoped db today)</font><br/><font point-size='9' color='#1b5e20'><b>AUTHORITATIVE RELATIONAL</b></font><br/><font color='#37474f'>used by WebODM webapp, WebODM worker, NodeODM, Metabase</font><br/><font color='#37474f'>(reporting)</font><br/><font >Mapping projects, processing state, users, geospatial data.</font><br/><font color='#b71c1c'>!! Large image/output artifacts remain filesystem data on</font><br/><font color='#b71c1c'>/media/scottw/500GBPHOTOGRAM/.</font><br/><font point-size='8' color='#6a1b9a'>status: current_migration_state</font>>];
  }
  subgraph cluster_db_n_postgresql {
    label=<<b>PostgreSQL 18 (system-wide relational platform)</b> <font point-size="9">(7)</font>>; style="rounded,filled"; fillcolor="#fafbfd"; color="#7986cb"; fontsize=12;
    n_db_host_postgres [shape=box, style="rounded,filled", fillcolor="#c8e6c9", color="#1b5e20", penwidth=1.5, label=<<b>Host PostgreSQL 18.6 cluster</b><br/><font color='#0d47a1'>postgresql-18 18.6 + PostGIS 3.6.2 (host systemd service)</font><br/><font point-size='9' color='#1b5e20'><b>AUTHORITATIVE RELATIONAL</b></font><br/><font point-size='9' color='#1565c0'>listen 127.0.0.1:5432</font><br/><font point-size='9' color='#1565c0'>listen [::1]:5432</font><br/><font point-size='9' color='#1565c0'>listen unix:/var/run/postgresql/.s.PGSQL.5432</font><br/><font >System-wide relational platform. One cluster, separate logical</font><br/><font >databases, separate application roles. REVOKE CONNECT FROM</font><br/><font >PUBLIC enforced.</font><br/><font color='#b71c1c'>!! Target end state. Some applications still run container-</font><br/><font color='#b71c1c'>scoped PostgreSQL during migration.</font><br/><font point-size='8' color='#6a1b9a'>status: active</font>>];
    n_db_salesdb [shape=box, style="rounded,filled", fillcolor="#c8e6c9", color="#1b5e20", penwidth=1.5, label=<<b>salesdb</b><br/><font color='#0d47a1'>PostgreSQL 18 (host cluster target)</font><br/><font point-size='9' color='#1b5e20'><b>AUTHORITATIVE RELATIONAL</b></font><br/><font color='#37474f'>used by Sales API, ao-payment (planned), Metabase (reporting)</font><br/><font >Authoritative sales/payment records: customers, orders,</font><br/><font >products, payments, receipts, entitlements, audit history.</font><br/><font color='#b71c1c'>!! Repository schema defined; live salesdb application schema</font><br/><font color='#b71c1c'>still requires explicit initialization. Container-scoped</font><br/><font color='#b71c1c'>sales-db exists today.</font><br/><font point-size='8' color='#6a1b9a'>status: current_migration_state</font>>];
    n_db_mastodon [shape=box, style="rounded,filled", fillcolor="#c8e6c9", color="#1b5e20", penwidth=1.5, label=<<b>mastodon</b><br/><font color='#0d47a1'>PostgreSQL 18 (in container-scoped mastodon-db today)</font><br/><font point-size='9' color='#1b5e20'><b>AUTHORITATIVE RELATIONAL</b></font><br/><font color='#37474f'>used by Mastodon web, Mastodon Sidekiq, Mastodon streaming</font><br/><font >Mastodon application state: accounts, posts, media metadata,</font><br/><font >federation state, background-job data.</font><br/><font color='#b71c1c'>!! CONSOLIDATION INCOMPLETE: container-scoped mastodon-db is</font><br/><font color='#b71c1c'>running on ao-sales while the documented target is the host</font><br/><font color='#b71c1c'>cluster.</font><br/><font point-size='8' color='#6a1b9a'>status: current_migration_state</font>>];
    n_db_grafana [shape=box, style="rounded,filled", fillcolor="#c8e6c9", color="#1b5e20", penwidth=1.5, label=<<b>grafana</b><br/><font color='#0d47a1'>PostgreSQL 18 (host cluster)</font><br/><font point-size='9' color='#1b5e20'><b>AUTHORITATIVE RELATIONAL</b></font><br/><font color='#37474f'>used by Grafana ao-grafana</font><br/><font >Grafana users, dashboards, folders, datasource definitions,</font><br/><font >preferences, alert state.</font><br/><font color='#b71c1c'>!! Not a disposable dashboard: requires backup, restore</font><br/><font color='#b71c1c'>testing, migrations, health checks.</font><br/><font point-size='8' color='#6a1b9a'>status: target</font>>];
    n_db_metabase [shape=box, style="rounded,filled", fillcolor="#c8e6c9", color="#1b5e20", penwidth=1.5, label=<<b>metabase</b><br/><font color='#0d47a1'>PostgreSQL 18 (host cluster)</font><br/><font point-size='9' color='#1b5e20'><b>AUTHORITATIVE RELATIONAL</b></font><br/><font color='#37474f'>used by Metabase ao-metabase</font><br/><font >Metabase users, collections, questions, dashboards, database</font><br/><font >connections, settings.</font><br/><font color='#b71c1c'>!! Persistence confirmation and first protected read-only</font><br/><font color='#b71c1c'>query are open items.</font><br/><font point-size='8' color='#6a1b9a'>status: target</font>>];
    n_db_cordadb [shape=box, style="rounded,filled", fillcolor="#fff9c4", color="#f57f17", penwidth=1.5, style="rounded,filled,dashed", label=<<b>cordadb (Corda persistence)</b><br/><font color='#0d47a1'>PostgreSQL 18 — separate logical database with its own roles</font><br/><font color='#0d47a1'>and backup scope</font><br/><font point-size='9' color='#f57f17'><b>AUTHORITATIVE LEDGER</b></font><br/><font color='#37474f'>used by Corda node ao-ledger-core (planned)</font><br/><font >Corda persistence. AUTHORITATIVE LEDGER for sale/contract,</font><br/><font >receipt association, entitlement, approved state transitions.</font><br/><font color='#b71c1c'>!! Corda 5.2.2 persists in cordadb. Corda 4.14.2 (H2) was</font><br/><font color='#b71c1c'>retired 2026-09-28; it was a separate legacy scaffold, never a</font><br/><font color='#b71c1c'>Corda 5 staging target, and held no ledger state. Blocked on</font><br/><font color='#b71c1c'>operator key/certificate ceremony (v6 18.2/18.3).</font><br/><font point-size='8' color='#6a1b9a'>status: blocked</font>>];
    n_db_postgres_admin [shape=box, style="rounded,filled", fillcolor="#c8e6c9", color="#1b5e20", penwidth=1.5, label=<<b>postgres (administrative)</b><br/><font color='#0d47a1'>PostgreSQL 18 (host cluster)</font><br/><font point-size='9' color='#1b5e20'><b>AUTHORITATIVE RELATIONAL</b></font><br/><font color='#37474f'>used by Maintenance, backup, restore validation</font><br/><font >Administrative/maintenance database for the shared cluster.</font><br/><font point-size='8' color='#6a1b9a'>status: active</font>>];
    n_db_host_postgres -> n_db_salesdb [style=invis];
    n_db_salesdb -> n_db_mastodon [style=invis];
    n_db_mastodon -> n_db_grafana [style=invis];
    n_db_grafana -> n_db_metabase [style=invis];
    n_db_metabase -> n_db_cordadb [style=invis];
    n_db_cordadb -> n_db_postgres_admin [style=invis];
  }
  subgraph cluster_db_n_filesystem {
    label=<<b>Filesystem / local application state</b> <font point-size="9">(2)</font>>; style="rounded,filled"; fillcolor="#fafbfd"; color="#7986cb"; fontsize=12;
    n_db_filesystem_state [shape=box, style="rounded,filled", fillcolor="#eceff1", color="#546e7a", penwidth=1.5, label=<<b>Filesystem / local application state</b><br/><font color='#0d47a1'>Application files, logs, project files, local state</font><br/><font point-size='9' color='#546e7a'><b>NOT AUTHORITATIVE</b></font><br/><font color='#37474f'>used by LM Studio, OpenClaw, MeshChatX, QGroundControl,</font><br/><font color='#37474f'>ArduPilot, Gazebo, simulation tools, restic</font><br/><font >Operational or engineering data that is not automatically part</font><br/><font >of SQL reporting.</font><br/><font point-size='8' color='#6a1b9a'>status: active</font>>];
    n_db_mapping_media [shape=box, style="rounded,filled", fillcolor="#eceff1", color="#546e7a", penwidth=1.5, label=<<b>Photogrammetry media (filesystem, ext4)</b><br/><font color='#0d47a1'>/media/scottw/500GBPHOTOGRAM/ — ext4 /dev/sdb1, UUID verified</font><br/><font point-size='9' color='#546e7a'><b>NOT AUTHORITATIVE</b></font><br/><font color='#37474f'>used by WebODM, NodeODM, imagery intake/exporter</font><br/><font >Source imagery, orthophotos, point clouds, 3D model artifacts.</font><br/><font >Large binaries stay filesystem-resident; only metadata is in</font><br/><font >webodm.</font><br/><font color='#b71c1c'>!! Deploy or operate WebODM only after the drive and mount are</font><br/><font color='#b71c1c'>validated (v6 8.5).</font><br/><font point-size='8' color='#6a1b9a'>status: implemented</font>>];
    n_db_filesystem_state -> n_db_mapping_media [style=invis];
  }
  subgraph cluster_db_n_h2 {
    label=<<b>H2 (retained migration backups only)</b> <font point-size="9">(1)</font>>; style="rounded,filled"; fillcolor="#fafbfd"; color="#7986cb"; fontsize=12;
    n_db_h2_legacy [shape=box, style="rounded,filled", fillcolor="#ffcdd2", color="#b71c1c", penwidth=1.5, label=<<b>H2 legacy migration backups</b><br/><font color='#0d47a1'>H2 (retained backup files only)</font><br/><font point-size='9' color='#b71c1c'><b>NOT AN APPROVED APPLICATION DB</b></font><br/><font color='#37474f'>used by Grafana/Metabase legacy migration</font><br/><font >No longer active; retained temporarily for rollback and</font><br/><font >migration evidence.</font><br/><font color='#b71c1c'>!! H2 and SQLite are NOT approved application databases for</font><br/><font color='#b71c1c'>Grafana or Metabase. Separately, the Corda H2 scaffold is a</font><br/><font color='#b71c1c'>known defect (see cordadb).</font><br/><font point-size='8' color='#6a1b9a'>status: not_active</font>>];
  }
  subgraph cluster_db_n_redis {
    label=<<b>Redis 8 (cache and coordination - not a system of record)</b> <font point-size="9">(3)</font>>; style="rounded,filled"; fillcolor="#fafbfd"; color="#7986cb"; fontsize=12;
    n_db_host_redis [shape=box, style="rounded,filled", fillcolor="#eceff1", color="#546e7a", penwidth=1.5, label=<<b>Host Redis 8.0.5 (database 0)</b><br/><font color='#0d47a1'>redis-server 8.0.5 (host systemd service)</font><br/><font point-size='9' color='#546e7a'><b>NOT AUTHORITATIVE</b></font><br/><font point-size='9' color='#1565c0'>listen 127.0.0.1:6379</font><br/><font color='#37474f'>used by general coordination</font><br/><font >General low-latency cache/coordination layer. NOT a system of</font><br/><font >record; no current application data confirmed.</font><br/><font point-size='8' color='#6a1b9a'>status: active</font>>];
    n_db_mastodon_redis [shape=box, style="rounded,filled", fillcolor="#eceff1", color="#546e7a", penwidth=1.5, label=<<b>mastodon-redis (database 0)</b><br/><font color='#0d47a1'>Redis 8 (container-scoped)</font><br/><font point-size='9' color='#546e7a'><b>NOT AUTHORITATIVE</b></font><br/><font color='#37474f'>used by Mastodon web, Mastodon Sidekiq</font><br/><font >Mastodon cache, queues, background-job coordination. Not</font><br/><font >authoritative business data.</font><br/><font point-size='8' color='#6a1b9a'>status: active</font>>];
    n_db_broker [shape=box, style="rounded,filled", fillcolor="#eceff1", color="#546e7a", penwidth=1.5, label=<<b>broker (database 0)</b><br/><font color='#0d47a1'>Redis 8 (container-scoped)</font><br/><font point-size='9' color='#546e7a'><b>NOT AUTHORITATIVE</b></font><br/><font color='#37474f'>used by WebODM worker, WebODM broker</font><br/><font >Celery/task broker and worker coordination. Not authoritative</font><br/><font >mapping data.</font><br/><font point-size='8' color='#6a1b9a'>status: active</font>>];
    n_db_host_redis -> n_db_mastodon_redis [style=invis];
    n_db_mastodon_redis -> n_db_broker [style=invis];
  }
  subgraph cluster_db_n_sqlite {
    label=<<b>SQLite (embedded desktop state)</b> <font point-size="9">(5)</font>>; style="rounded,filled"; fillcolor="#fafbfd"; color="#7986cb"; fontsize=12;
    n_db_openclaw [shape=box, style="rounded,filled", fillcolor="#eceff1", color="#546e7a", penwidth=1.5, label=<<b>OpenClaw SQLite state</b><br/><font color='#0d47a1'>SQLite (desktop application state)</font><br/><font point-size='9' color='#546e7a'><b>NOT AUTHORITATIVE</b></font><br/><font point-size='9' color='#455a64'>path ~/.openclaw/state/openclaw.sqlite</font><br/><font color='#37474f'>used by OpenClaw gateway, OpenClaw chat relay</font><br/><font >Local operational state. Not part of SQL reporting.</font><br/><font point-size='8' color='#6a1b9a'>status: active</font>>];
    n_db_akonadi [shape=box, style="rounded,filled", fillcolor="#eceff1", color="#546e7a", penwidth=1.5, label=<<b>Akonadi / KDE PIM SQLite</b><br/><font color='#0d47a1'>SQLite (desktop application state)</font><br/><font point-size='9' color='#546e7a'><b>NOT AUTHORITATIVE</b></font><br/><font color='#37474f'>used by Akonadi, KDE PIM</font><br/><font >Contacts, calendars, mail indexes, local personal-information</font><br/><font >data.</font><br/><font point-size='8' color='#6a1b9a'>status: active</font>>];
    n_db_browsers [shape=box, style="rounded,filled", fillcolor="#eceff1", color="#546e7a", penwidth=1.5, label=<<b>Browser profile SQLite stores</b><br/><font color='#0d47a1'>SQLite (Konqueror/KDE WebEngine, Firefox, Brave, Chrome, Edge)</font><br/><font point-size='9' color='#546e7a'><b>NOT AUTHORITATIVE</b></font><br/><font color='#37474f'>used by browsers</font><br/><font >History, site storage, caches, certificates, profile data.</font><br/><font point-size='8' color='#6a1b9a'>status: active</font>>];
    n_db_podman [shape=box, style="rounded,filled", fillcolor="#eceff1", color="#546e7a", penwidth=1.5, label=<<b>Podman rootless metadata store</b><br/><font color='#0d47a1'>SQLite (rootless Podman)</font><br/><font point-size='9' color='#546e7a'><b>NOT AUTHORITATIVE</b></font><br/><font color='#37474f'>used by Podman</font><br/><font >Container, image, network, volume metadata. Not application</font><br/><font >data.</font><br/><font point-size='8' color='#6a1b9a'>status: active</font>>];
    n_db_sim_local [shape=box, style="rounded,filled", fillcolor="#eceff1", color="#546e7a", penwidth=1.5, label=<<b>ROS / simulation local SQLite</b><br/><font color='#0d47a1'>SQLite (application-specific local files)</font><br/><font point-size='9' color='#546e7a'><b>NOT AUTHORITATIVE</b></font><br/><font color='#37474f'>used by ROS 2 Lyrical, Gazebo Sim, ArduPilot SITL,</font><br/><font color='#37474f'>QGroundControl</font><br/><font >Local tool state where enabled. Not a shared reporting source.</font><br/><font point-size='8' color='#6a1b9a'>status: active</font>>];
    n_db_openclaw -> n_db_akonadi [style=invis];
    n_db_akonadi -> n_db_browsers [style=invis];
    n_db_browsers -> n_db_podman [style=invis];
    n_db_podman -> n_db_sim_local [style=invis];
  }
  subgraph cluster_db_n_tsdb {
    label=<<b>Prometheus TSDB (metrics, health, alerting)</b> <font point-size="9">(1)</font>>; style="rounded,filled"; fillcolor="#fafbfd"; color="#7986cb"; fontsize=12;
    n_db_prometheus [shape=box, style="rounded,filled", fillcolor="#eceff1", color="#546e7a", penwidth=1.5, label=<<b>Prometheus TSDB</b><br/><font color='#0d47a1'>prometheus v3.4.1 — /prometheus persistent volume</font><br/><font point-size='9' color='#546e7a'><b>NOT AUTHORITATIVE</b></font><br/><font color='#37474f'>used by Grafana (metrics datasource), alerting, rule</font><br/><font color='#37474f'>evaluation</font><br/><font >Specialized time-series store: metrics, service health,</font><br/><font >resource usage, operational monitoring. Works without Grafana.</font><br/><font color='#b71c1c'>!! Grafana visualizes metrics; Prometheus remains the separate</font><br/><font color='#b71c1c'>metrics store and the alerting layer.</font><br/><font point-size='8' color='#6a1b9a'>status: implemented</font>>];
  }

  n_db_host_postgres -> n_db_salesdb [label="logical database", color="#9fa8da", style=dashed, fontcolor="#3949ab"];
  n_db_host_postgres -> n_db_mastodon [label="logical database", color="#9fa8da", style=dashed, fontcolor="#3949ab"];
  n_db_host_postgres -> n_db_webodm [label="logical database", color="#9fa8da", style=dashed, fontcolor="#3949ab"];
  n_db_host_postgres -> n_db_grafana [label="logical database", color="#9fa8da", style=dashed, fontcolor="#3949ab"];
  n_db_host_postgres -> n_db_metabase [label="logical database", color="#9fa8da", style=dashed, fontcolor="#3949ab"];
  n_db_host_postgres -> n_db_cordadb [label="logical database", color="#9fa8da", style=dashed, fontcolor="#3949ab"];
  n_db_host_postgres -> n_db_postgres_admin [label="logical database", color="#9fa8da", style=dashed, fontcolor="#3949ab"];
}
