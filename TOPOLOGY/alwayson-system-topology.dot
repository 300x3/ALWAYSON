digraph alwayson {
  graph [rankdir=LR, compound=true, newrank=true, concentrate=true, fontname="DejaVu Sans", fontsize=11, bgcolor="#ffffff", nodesep=0.45, ranksep=0.8, splines=spline, pad=0.3, labelloc=t, fontsize=24, label=<<b>ALWAYS ON — TOPOLOGY OVERVIEW</b><br/><font point-size="11">networks · data stores · external paths · status · generated 2026-10-03T19:52:47Z (live inspection)</font><br/><font point-size="10">17 networks · 22 containers (25 running) · 53 listeners (30 loopback) · 4 drift items — authority: v6 §3.3.1/§5.1/§5.2/§6.A/§20.0</font>>];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10, margin="0.14,0.09", penwidth=1.4];
  edge [fontname="DejaVu Sans", fontsize=9, color="#607d8b", penwidth=1.1, arrowsize=0.7];
  subgraph cluster_edge {
    label=<<b>CONTROLLED EXTERNAL PATHS</b> <font point-size="9">(README §5.2)</font>>; style="rounded,filled"; fillcolor="#f3f7fb"; color="#1565c0"; fontsize=12;
    n_internet [shape=ellipse, fillcolor="#cfd8dc", color="#37474f", fontsize=12, label="PUBLIC INTERNET"];
    n_edge_cloudflare_tunnel [style="rounded,filled", fillcolor="#e8f5e9", color="#1b5e20", label=<<b>Cloudflare Tunnel (cloudflared-alwayson.service)</b><br/>cloudflared<br/>listen 127.0.0.1:20241 (metrics)<br/>mastodon.300x3.com -&gt; 127.0.0.1:3000<br/>chat.300x3.com -&gt; 127.0.0.1:18790 (OpenClaw relay / sitebot)<br/>www.300x3.com -&gt; 127.0.0.1:3300 (300X3 storefront proxy)>];
    n_edge_pcloud_storefront [style="rounded,filled", fillcolor="#e8f5e9", color="#1b5e20", label=<<b>pCloud Public Folder (static HTML storefront)</b><br/>pCloud Drive / public folder<br/><i>direction: outbound</i>>];
    n_edge_ao_egress_archive [style="rounded,filled", fillcolor="#eceff1", color="#455a64", label=<<b>ao-egress-archive (adapter, not yet deployed)</b><br/>encrypted archive replication / IPFS operations<br/><i>direction: outbound</i><br/>status: planned>];
    n_edge_ao_ingress_payment [style="rounded,filled", fillcolor="#eceff1", color="#455a64", label=<<b>ao-ingress-payment (adapter, not yet deployed)</b><br/>payment-provider webhook verifier<br/><i>direction: inbound</i><br/>status: planned>];
    n_edge_ao_build_update [style="rounded,filled", fillcolor="#f5f5f5", color="#616161", label=<<b>ao-build-update (adapter, deployed, not enabled)</b><br/>image / package acquisition before controlled promotion<br/><i>direction: outbound</i><br/>status: scaffolded>];
    n_edge_reticulum_tcp [style="rounded,filled", fillcolor="#fff3e0", color="#ef6c00", label=<<b>Reticulum public TCP peers / backbone</b><br/>29 TCPClientInterface peers (public gateway 0.0.0.0:4242)<br/><i>direction: bidirectional</i><br/>status: in_progress>];
    n_adapter_placeholders [shape=box, style="rounded,dashed", fillcolor="#eceff1", color="#455a64", label="ao-ingress-payment\nao-egress-archive\nao-build-update\n(adapters, not deployed)"];
  }

  n_datastore_summary [shape=box3d, fillcolor="#e8eaf6", color="#283593", fontsize=11, label=<<b>DATA STORES</b><br/><font point-size="9">20 databases &amp; data stores (v6 §3.3.1)</font><br/><font point-size="9" color="#283593">8 relational (PostgreSQL 18 / PostGIS)</font><br/><font point-size="9" color="#455a64">12 non-relational (Redis, Prometheus TSDB, SQLite, filesystem, H2 legacy)</font><br/><font point-size="8">full registry: alwayson-databases.svg</font>>];

