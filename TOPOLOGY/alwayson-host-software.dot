digraph alwayson {
  graph [rankdir=LR, compound=true, newrank=true, concentrate=true, fontname="DejaVu Sans", fontsize=11, bgcolor="#ffffff", nodesep=0.45, ranksep=0.8, splines=spline, pad=0.3, labelloc=t, fontsize=24, label=<<b>ALWAYS ON — HOST SOFTWARE &amp; OPERATOR ACCESS</b><br/><font point-size="11">systemd services · desktop software · loopback-only operator access · generated 2026-10-03T19:52:47Z (live inspection)</font><br/><font point-size="10">17 networks · 22 containers (25 running) · 53 listeners (30 loopback) · 4 drift items — authority: v6 §3.3.1/§5.1/§5.2/§6.A/§20.0</font>>];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10, margin="0.14,0.09", penwidth=1.4];
  edge [fontname="DejaVu Sans", fontsize=9, color="#607d8b", penwidth=1.1, arrowsize=0.7];
  n_host [shape=box3d, fillcolor="#e3f2fd", color="#0d47a1", fontsize=12, label=<<b>ALWAYS ON HOST — Kubuntu 26.04 LTS workstation</b><br/>Kubuntu 26.04 LTS (Ubuntu 26.04.1 userland)<br/>kernel 7.0.0-34-generic · AMD CPU<br/>EVGA NVIDIA GTX 1080 (driver 580.178.04, CDI nvidia.com/gpu=0)<br/><i>Podman 5.7.0 — Quadlet only, no Docker daemon</i><br/>eno1: 169.254.248.253/16 10.42.0.1/24<br/>wlp3s0: 192.168.87.135/24 fe80::abd7:e952:c515:db0d/64>];

  subgraph cluster_hostsw {
    label=<<b>HOST SOFTWARE (non-container)</b> <font point-size="9">(v6 §3.3, §9.2, §20.0)</font>>; style="rounded,filled"; fillcolor="#f1f8e9"; color="#33691e"; fontsize=12;
    n_host_postgresql [style="rounded,filled", fillcolor="#e8f5e9", color="#1b5e20", label=<<b>PostgreSQL 18.6 (host cluster)</b><br/>postgresql-18 18.6 / PostGIS 3.6.2<br/><font color='#1565c0'>listen 127.0.0.1:5432</font><br/><font color='#1565c0'>listen [::1]:5432</font><br/><font color='#1565c0'>listen unix:/var/run/postgresql/.s.PGSQL.5432</font><br/><font color='#1565c0'>relay 10.42.0.1:5432 (socat, ao-postgres-reporting-bridge)</font><br/><font >System-wide relational platform: separate logical</font><br/><font >databases, separate application roles</font><br/><font color='#6d4c41'>AUTHORITATIVE RELATIONAL. REVOKE CONNECT FROM PUBLIC</font><br/><font color='#6d4c41'>enforced (v6 3.3). Target is one host cluster;</font><br/><font color='#6d4c41'>container-scoped instances are current migration</font><br/><font color='#6d4c41'>state.</font>>];
    n_host_redis [style="rounded,filled", fillcolor="#e8f5e9", color="#1b5e20", label=<<b>Redis 8.0.5 (host service)</b><br/>redis-server 8.0.5<br/><font color='#1565c0'>listen 127.0.0.1:6379</font><br/><font >Low-latency cache/coordination layer (not a system</font><br/><font >of record)</font>>];
    n_host_ardupilot_sitl [style="rounded,filled", fillcolor="#e8f5e9", color="#1b5e20", label=<<b>ArduPilot SITL (host systemd service)</b><br/>arducopter SITL, ArduPilot e57b8a47d3 (4.6.0-beta1)<br/><font color='#1565c0'>listen tcp/127.0.0.1:5760</font><br/><font >/ALWAYSON/data/ardupilot</font><br/><font color='#6d4c41'>Runs on host for real-time constraints;</font><br/><font color='#6d4c41'>QGroundControl connects over tcp:5760 (v6 10.1)</font>>];
    n_host_restic [style="rounded,filled", fillcolor="#e8f5e9", color="#1b5e20", label=<<b>restic encrypted backup (host)</b><br/>restic — encrypted local snapshots + encrypted pCloud replication<br/><font >PostgreSQL/Corda-aware encrypted backup; restore</font><br/><font >test in an isolated location</font><br/><font color='#6d4c41'>Local authority + encrypted restic + encrypted</font><br/><font color='#6d4c41'>pCloud replication. Independent of IPFS and Corda</font><br/><font color='#6d4c41'>(v6 ES.1).</font>>];
    n_host_kwallet [style="rounded,filled", fillcolor="#e8f5e9", color="#1b5e20", label=<<b>KDE Wallet (kwalletd6) — secret authority</b><br/>org.kde.kwalletd6 via Plasma login → kwalletd6 unlock → fetch-kwallet-secret.sh (ExecStartPre, ≤60s)<br/><font >0600 env file per unit; services needing Wallet</font><br/><font >secrets start AFTER login BY DESIGN</font><br/><font color='#6d4c41'>Secret authority is settled; the D-Bus bus name and</font><br/><font color='#6d4c41'>method names on the running host are unconfirmed (v6</font><br/><font color='#6d4c41'>14.1.1).</font>>];
    n_desktop_meshchatx [style="rounded,filled", fillcolor="#e8f5e9", color="#1b5e20", label=<<b>MeshChatX native backend / web UI</b><br/>ReticulumMeshChatX 4.9.1 (native headless)<br/><font color='#1565c0'>listen https://127.0.0.1:18000</font>>];
    n_desktop_reticulum [style="rounded,filled", fillcolor="#fff3e0", color="#ef6c00", label=<<b>Reticulum transport (embedded in MeshChatX)</b><br/>RNS embedded; standalone rnsd 1.4.2 present but not running<br/><font color='#1565c0'>listen 0.0.0.0:4242 (backbone; NOT loopback-restricted)</font>>];
    n_desktop_openclaw [style="rounded,filled", fillcolor="#e8f5e9", color="#1b5e20", label=<<b>OpenClaw AI gateway + CORS relay</b><br/>OpenClaw gateway (password auth) + chat relay<br/><font color='#1565c0'>listen 127.0.0.1:18789</font><br/><font color='#1565c0'>listen 127.0.0.1:18790</font>>];
    n_desktop_lmstudio [style="rounded,filled", fillcolor="#e8f5e9", color="#1b5e20", label=<<b>LM Studio headless inference server</b><br/>LM Studio (OpenAI-compatible endpoint, REST auth enforced)<br/><font color='#1565c0'>listen 127.0.0.1:1234</font>>];
    n_desktop_qgc [style="rounded,filled", fillcolor="#fff8e1", color="#f9a825", label=<<b>QGroundControl GCS (AppImage)</b><br/>QGroundControl<br/>connects tcp/127.0.0.1:5760 (SITL)<br/>connects MAVLink over DRONE-RADIO>];
    n_ao_sim_fabrication_foxglove [style="rounded,filled", fillcolor="#e8f5e9", color="#1b5e20", label=<<b>Fabrication simulation viewer (Foxglove)</b><br/>foxglove_bridge 3.5.0, ros_gz_bridge (ros-lyrical-foxglove-bridge)<br/><font color='#1565c0'>listen 127.0.0.1:8081 (foxglove_bridge ws, loopback only)</font><br/>connects ao-html-window + ao-sim-fabrication<br/>connects gz /factory/camera/image<br/><i>ROS_DOMAIN_ID=22</i><br/><i>GZ_PARTITION=alwayson_fabrication_sim</i>>];
    n_ao_sim_fabrication_portal [style="rounded,filled", fillcolor="#e8f5e9", color="#1b5e20", label=<<b>Fabrication simulation portal (view-only HTML)</b><br/>python3 http.server serving GAZEBO/portal/index.html<br/><font color='#1565c0'>listen 127.0.0.1:8765 (http, loopback only)</font>>];
    n_desktop_konqueror [style="rounded,filled", fillcolor="#e8f5e9", color="#1b5e20", label=<<b>Konqueror (browser; Tokodon removed per ES.1)</b><br/>Konqueror / KDE WebEngine<br/>connects http://127.0.0.1:3000 (Mastodon)<br/>connects http://127.0.0.1:3001 (Grafana)<br/>connects http://127.0.0.1:3002 (Metabase)<br/>connects http://127.0.0.1:8000 (WebODM)>];
    n_desktop_sketchup [style="rounded,filled", fillcolor="#eceff1", color="#455a64", label=<<b>SketchUp / SketchUp Web (design, host)</b><br/>SketchUp desktop + SketchUp Web>];
  }

  n_operator [shape=box, fillcolor="#f3e5f5", color="#6a1b9a", fontsize=10, label=<<b>OPERATOR ACCESS (loopback only)</b><br/>Konqueror / QGroundControl / Podman Desktop<br/>no public port; listener-allowlist is empty<br/>127.0.0.1:1234/tcp llmster<br/>127.0.0.1:3000/tcp rootlessport<br/>127.0.0.1:3001/tcp rootlessport<br/>127.0.0.1:3002/tcp rootlessport<br/>127.0.0.1:3300/tcp python3<br/>127.0.0.1:4000/tcp rootlessport<br/>+16 more loopback listeners — see listener table>];

