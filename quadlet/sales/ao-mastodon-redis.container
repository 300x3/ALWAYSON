# QUADLET - ALWAYS ON Mastodon Redis (container-scoped, ao-sales)
[Unit]
Description=ALWAYS ON Mastodon Redis (mastodon-redis)
After=graphical-session.target network-session.target ao-sales-network.service
PartOf=graphical-session.target

[Container]
Image=docker.io/library/redis@sha256:c6eabf748fc7a61dbb5a705c78bcf3d6377b1127a97d0ce965c11c44ba46896f
ContainerName=mastodon-redis
Network=ao-sales.network
NoNewPrivileges=true
HealthCmd=redis-cli ping
HealthInterval=30s

[Service]
Restart=on-failure
RestartSec=15
MemoryMax=512M

[Install]
WantedBy=graphical-session.target