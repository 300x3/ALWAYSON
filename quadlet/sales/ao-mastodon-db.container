# /ALWAYSON/quadlet/sales/ao-mastodon-db.container
# ALWAYS ON Mastodon PostgreSQL - container-scoped on ao-sales (no host PG reuse)
[Unit]
Description=ALWAYS ON Mastodon PostgreSQL (mastodon-db)
After=graphical-session.target network-online.target ao-sales-network.service
Wants=network-online.target ao-sales-network.service
PartOf=graphical-session.target

[Container]
Image=docker.io/library/postgres@sha256:d74eeac9a635390a49bc21bd49fccd973de707e2a53a76ac49b552b8712ec46f
ContainerName=mastodon-db
Network=ao-sales.network
EnvironmentFile=%h/.local/share/ao-secrets/mastodon-db.env
NoNewPrivileges=true
HealthCmd=pg_isready -U mastodon
HealthInterval=30s
Volume=mastodon-dbdata:/var/lib/postgresql/data:Z

[Service]
WorkingDirectory=%h
ExecStartPre=/ALWAYSON/scripts/operations/fetch-kwallet-secret.sh %h/.local/share/ao-secrets/mastodon-db.env mastodon-db-password
Restart=on-failure
RestartSec=15
MemoryMax=2G
TimeoutStartSec=300

[Install]
WantedBy=graphical-session.target
