# /ALWAYSON/quadlet/sales/ao-sales-db.container
[Unit]
Description=ALWAYS ON Sales PostgreSQL (salesdb)
After=graphical-session.target network-online.target
Wants=network-online.target
PartOf=graphical-session.target

[Container]
Image=postgres@sha256:a65e6a841f6c4dbc4abda3d67fa3bc21824e9611064fcd82e87ea67aad60a0c3
ContainerName=ao-sales-db
Network=ao-sales.network
Volume=%h/webodm/sales-dbdata:/var/lib/postgresql/data:Z
EnvironmentFile=%h/secrets/sales-db.env
Environment=POSTGRES_DB=salesdb
Environment=POSTGRES_USER=sales_migration_role
NoNewPrivileges=true
# Loopback-only listener so the host reporting hub (PostgreSQL 18) can reach
# this database with postgres_fdw. Section 6.A.2 sanctions a documented narrow
# relay path into the ao-admin reporting plane; it does NOT sanction joining
# ao-sales to the reporting containers. Bound to 127.0.0.1 so it is never
# reachable from the LAN (the previous reporting bridge published the host
# cluster on the eno1 NIC by mistake and was removed 2026-09-25).
PublishPort=127.0.0.1:15432:5432
HealthCmd=pg_isready
HealthInterval=30s

[Service]
ExecStartPre=/ALWAYSON/scripts/operations/fetch-kwallet-secret.sh %h/secrets/sales-db.env sales-db-password
Restart=on-failure
RestartSec=15
MemoryMax=2G
TimeoutStartSec=300

[Install]
WantedBy=graphical-session.target
