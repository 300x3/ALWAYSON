# QUADLET/sales/ao-mastodon-streaming.container
# ALWAYS ON Mastodon streaming API - loopback-only (127.0.0.1:4000)
[Unit]
Description=ALWAYS ON Mastodon Streaming
After=ao-mastodon-redis.service ao-sales-network.service
Wants=ao-mastodon-redis.service

[Container]
Image=ghcr.io/mastodon/mastodon-streaming:v4.3.7
ContainerName=mastodon-streaming
Network=ao-sales-network.network
EnvironmentFile=%h/secrets/mastodon.env
PublishPort=127.0.0.1:4000:4000
NoNewPrivileges=true
Exec=/bin/sh -c "node ./streaming/index.js"

[Service]
WorkingDirectory=%h
Restart=on-failure
RestartSec=15
MemoryMax=2G

[Install]
WantedBy=default.target