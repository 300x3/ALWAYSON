# QUADLET/sales/ao-mastodon-streaming.container
# ALWAYS ON Mastodon streaming API - loopback-only (127.0.0.1:4000)
[Unit]
Description=ALWAYS ON Mastodon Streaming
After=graphical-session.target ao-mastodon-redis.service ao-sales-network.service
Wants=ao-mastodon-redis.service
PartOf=graphical-session.target

[Container]
# Digest-pinned 2026-10-01 (README 4.1 rule 9). Tag was mastodon-streaming:v4.3.7;
# mastodon-web/sidekiq were already digest-pinned, so this closes the gap
# within the same stack.
Image=ghcr.io/mastodon/mastodon-streaming@sha256:24834e873cc79ae0677c7e5938e575b4367f2c1c6df46376eb7aa937ee467f4b
ContainerName=mastodon-streaming
Network=ao-sales.network
EnvironmentFile=%h/.local/share/ao-secrets/mastodon.env
PublishPort=127.0.0.1:4000:4000
NoNewPrivileges=true
Exec=/bin/sh -c "node ./streaming/index.js"

[Service]
WorkingDirectory=%h
Restart=on-failure
RestartSec=15
MemoryMax=2G

[Install]
WantedBy=graphical-session.target