[Unit]
Description=OpenClaw Gateway (v2026.7.1-2)
# Starts at graphical login (wallet unlock), not at boot: the gateway requires
# the KDE Wallet LM Studio token, so pre-login it could only fail-loop.
After=network-online.target graphical-session.target
PartOf=graphical-session.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
ExecStart=/usr/bin/node /home/scottw/.npm-global/lib/node_modules/openclaw/dist/index.js gateway --port 18789
Restart=always
RestartSec=5
RestartPreventExitStatus=78
TimeoutStopSec=30
TimeoutStartSec=30
SuccessExitStatus=0 143
OOMPolicy=continue
KillMode=control-group
Environment=HOME=/home/scottw
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=TMPDIR=/tmp
Environment=PATH=/usr/bin:/home/scottw/.npm-global/bin:/usr/local/bin:/bin:/home/scottw/.local/bin:/home/scottw/bin:/home/scottw/.nix-profile/bin:/home/scottw/.local/share/pnpm/bin:/home/scottw/.local/share/pnpm
Environment=OPENCLAW_GATEWAY_PORT=18789
Environment=OPENCLAW_SYSTEMD_UNIT=openclaw-gateway.service
Environment="OPENCLAW_WINDOWS_TASK_NAME=OpenClaw Gateway"
Environment=OPENCLAW_WINDOWS_TASK_HIDDEN_LAUNCHER=1
Environment=OPENCLAW_SERVICE_MARKER=openclaw
Environment=OPENCLAW_SERVICE_KIND=gateway
Environment=OPENCLAW_SERVICE_VERSION=2026.7.1-2

[Install]
WantedBy=graphical-session.target
