# /ALWAYSON/quadlet/operations/ao-grafana.container
# Section 17.2 dashboard. ao-admin only; loopback-published (VPN/auth remote
# access requires separate approval).
[Unit]
Description=ALWAYS ON Grafana (ao-admin)
After=network-online.target ao-prometheus.service
Requires=ao-prometheus.service

[Container]
# Digest-pinned 2026-10-01 (README 4.1 rule 9). Tag was grafana-oss:11.6.0.
Image=docker.io/grafana/grafana-oss@sha256:b739cda4b61ba3b90707578b643a22cd851fecf4498e6c6ec2d8f9d622a5d0b2
ContainerName=ao-grafana
Network=ao-admin.network
Network=ao-reporting-egress.network
Volume=/var/run/postgresql:/var/run/postgresql:ro
Volume=/ALWAYSON/config/platform/monitoring/grafana/provisioning:/etc/grafana/provisioning:ro,Z
Volume=ao-grafana-postgres-data:/var/lib/grafana-postgres:Z
# Grafana is split in two on purpose (README 4.1 rule 7 / 14.1.1): this file
# carries ONLY non-secret settings and is safe to track in Git. The admin
# password is NOT here; it is held solely in KDE Wallet (ao-admin /
# grafana-admin-password) and materialised 0600 by the ExecStartPre below.
EnvironmentFile=/ALWAYSON/config/platform/monitoring/grafana-admin.env
EnvironmentFile=%h/.local/share/ao-secrets/reporting-grafana-admin.env
EnvironmentFile=%h/.local/share/ao-secrets/reporting-grafana-postgres.env
PublishPort=127.0.0.1:3001:3000
NoNewPrivileges=true
DropCapability=all

# PostgreSQL owns all active Grafana application state. Legacy SQLite is not
# mounted or used at runtime.
[Service]
ExecStartPre=/usr/bin/bash -c 'install -d -m 0700 %h/.local/share/ao-secrets && /ALWAYSON/scripts/operations/fetch-kwallet-secret.sh %h/.local/share/ao-secrets/reporting-grafana-admin.env grafana-admin-password'
ExecStartPre=/usr/bin/bash -c 'install -d -m 0700 %h/.local/share/ao-secrets && /ALWAYSON/scripts/operations/fetch-reporting-env.sh grafana %h/.local/share/ao-secrets/reporting-grafana-postgres.env'
MemoryMax=1G
Restart=on-failure

[Install]
WantedBy=default.target
