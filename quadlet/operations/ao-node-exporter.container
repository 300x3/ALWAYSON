# /ALWAYSON/quadlet/operations/ao-node-exporter.container
# Host metrics exporter. Attached to ao-admin ONLY; exposes metrics to
# Prometheus over the internal bridge; no published port.
[Unit]
Description=ALWAYS ON node exporter (ao-admin)
After=network-online.target

[Container]
# Digest-pinned 2026-10-01 (README 4.1 rule 9). Tag was prom/node-exporter:v1.9.1.
Image=docker.io/prom/node-exporter@sha256:863b62ff9f392b6f472e22b4b670ad1cabb66b3042502ebd4b2cd192733e1bce
ContainerName=ao-node-exporter
Network=ao-admin.network
Volume=/:/host:ro
SecurityLabelDisable=true
NoNewPrivileges=true
DropCapability=all
Exec=--path.rootfs=/host


[Service]
MemoryMax=256M
Restart=on-failure

[Install]
WantedBy=default.target
