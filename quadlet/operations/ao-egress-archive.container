# /ALWAYSON/quadlet/operations/ao-egress-archive.container
# ALWAYS ON archive adapter (ao-egress-archive) — Section 11.6, Section 5.2
# Outbound adapter for encrypted pCloud replication and approved IPFS operations.
# Internal=false because it must reach external services (pCloud, IPFS gateways).
# No public port published — all traffic is outbound only.
# Credentials are provisioned via KDE Wallet (ao-archive folder) and materialized
# 0600 by ExecStartPre. No secrets in this file.
[Unit]
Description=ALWAYS ON Archive Egress Adapter (ao-egress-archive)
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/library/python@sha256:79e7a9b9ff1cbceff819f856fb374477792a5967759d94df266de7b7b4120e6f
ContainerName=ao-egress-archive
Network=ao-egress-archive.network
Volume=/ALWAYSON/scripts/backup:/opt/ao-egress-archive/scripts:ro,Z
Volume=/ALWAYSON/data/ao-egress-archive:/var/lib/ao-egress-archive:rw,Z
Environment=AO_EGRESS_STAGING=/var/lib/ao-egress-archive
NoNewPrivileges=true
DropCapability=ALL
# Validate environment and credentials; no network call
Exec=/usr/bin/python3 /opt/ao-egress-archive/scripts/sale-transfer.sh --plan

[Service]
Type=oneshot
Restart=no
TimeoutStartSec=300

[Install]
WantedBy=graphical-session.target
