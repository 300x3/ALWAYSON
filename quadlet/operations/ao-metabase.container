# /ALWAYSON/quadlet/operations/ao-metabase.container
# Section 6.A.2 reporting tool. PostgreSQL application database, loopback UI.
[Unit]
Description=ALWAYS ON Metabase (ao-admin)
After=network-online.target

[Container]
Image=docker.io/metabase/metabase:v0.54.1
Entrypoint=["/opt/java/openjdk/bin/java","-jar","/app/metabase.jar"]
EnvironmentFile=%h/.local/share/alwayson-secrets/reporting-metabase.env
ContainerName=ao-metabase
Network=ao-admin.network
Network=ao-reporting-egress.network
Volume=/var/run/postgresql:/var/run/postgresql:ro
Volume=ao-metabase-postgres-data:/metabase-postgres-data:Z
PublishPort=127.0.0.1:3002:3000
NoNewPrivileges=true
DropCapability=all

[Service]
ExecStartPre=/usr/bin/bash -c 'install -d -m 0700 %h/.local/share/alwayson-secrets && /ALWAYSON/scripts/operations/fetch-reporting-env.sh metabase %h/.local/share/alwayson-secrets/reporting-metabase.env'
MemoryMax=2G
Restart=on-failure

[Install]
WantedBy=default.target