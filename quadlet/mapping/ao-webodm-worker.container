# /ALWAYSON/quadlet/mapping/ao-webodm-worker.container
[Unit]
Description=ALWAYS ON WebODM Worker
After=ao-webodm-db.service ao-webodm-web.service
Wants=ao-webodm-db.service

[Container]
Image=webodm/webodm_webapp@sha256:188267c654c27a0f5352b0ff27ebe777788637df06d948d80ccb8513c72abd38
ContainerName=ao-webodm-worker
Network=ao-mapping.network
Volume=/media/scottw/500GBPHOTOGRAM/webodm/media:/webodm/app/media:Z
EnvironmentFile=%h/secrets/webodm.env
Environment=WO_DEBUG=NO
Environment=WO_DATABASE_HOST=ao-webodm-db
Environment=WO_BROKER=redis://ao-webodm-broker:6379
Environment=WEB_CONCURRENCY=1
Exec=/bin/bash -c "/webodm/wait-for-postgres.sh ao-webodm-db /webodm/wait-for-it.sh -t 0 ao-webodm-broker:6379 -- /webodm/wait-for-it.sh -t 0 ao-webodm-webapp:8000 -- /webodm/worker.sh start"
NoNewPrivileges=true

[Service]
Restart=on-failure
RestartSec=15
MemoryMax=6G
CPUQuota=400%
TimeoutStartSec=600

[Install]
WantedBy=default.target
