# /ALWAYSON/quadlet/mapping/ao-webodm-broker.container
[Unit]
Description=ALWAYS ON WebODM Redis Broker
[Container]
Image=docker.io/library/redis@sha256:c6eabf748fc7a61dbb5a705c78bcf3d6377b1127a97d0ce965c11c44ba46896f
ContainerName=ao-webodm-broker
Network=ao-mapping.network
NoNewPrivileges=true
HealthCmd=redis-cli ping
HealthInterval=30s
[Service]
Restart=on-failure
RestartSec=15
MemoryMax=512M
[Install]
WantedBy=default.target
