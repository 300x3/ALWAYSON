# /ALWAYSON/quadlet/mapping/ao-webodm-db.container
# ALWAYS ON WebODM PostgreSQL/PostGIS - Section 3.6 structural deployment
[Unit]
Description=ALWAYS ON WebODM Database (webodm_db)
After=network-online.target
Wants=network-online.target

[Container]
Image=webodm/webodm_db@sha256:03f18ec0089325ec2b8975ba1781277bcdc212b6d86c9de33f6409d313e90430
ContainerName=db
Network=ao-mapping.network
Volume=%h/webodm/dbdata:/var/lib/postgresql/data:Z
EnvironmentFile=%h/secrets/webodm.env
Environment=POSTGRES_DB=webodm
Environment=POSTGRES_USER=postgres
NoNewPrivileges=true
HealthCmd=pg_isready
HealthInterval=30s

[Service]
Restart=on-failure
RestartSec=15
MemoryMax=4G
TimeoutStartSec=300

[Install]
WantedBy=default.target
