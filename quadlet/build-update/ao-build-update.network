# /ALWAYSON/quadlet/build-update/ao-build-update.network
#
# ALWAYS ON build/update adapter network (README 5.1 group B, 5.2.1, ST-01).
#
# Internal=false, and that is deliberate. This is a CONTROLLED EGRESS network
# and it is the only thing that makes the adapter able to do its one job:
# fetch candidate images and packages from upstream registries.
#
# WHY A DEDICATED NETWORK, AND NOT ao-admin
# -----------------------------------------
# README 5.1 group B previously placed this adapter on "ao-admin (build/update
# duty)". ao-admin is Internal=true, which was verified to be fatal to the
# adapter's purpose:
#
#   $ podman run --rm --network ao-admin alpine nslookup registry-1.docker.io
#   ** server can't find registry-1.docker.io: NXDOMAIN
#   $ podman run --rm --network ao-reporting-egress alpine nc -z registry-1.docker.io 443
#   TCP OK
#
# Internal=true gives no external resolver and no outbound route, so a
# container on ao-admin cannot pull an image at all. The adapter was inert by
# construction. The README has been corrected; this network is the fix.
#
# ao-admin was also the wrong home on the merits: it is the monitoring and
# reporting plane ("Prometheus, node_exporter, Grafana, Metabase, backup/
# restore"). An update audit log is a compliance record, not a metric.
#
# CONTAINMENT - acquisition is the sanctioned outbound, nothing else:
#   - Outbound HTTPS/443 to the registry hosts named in
#     config/build-update/registry-allowlist.yaml, and nothing else.
#   - NO workload container is ever attached to this network. The adapter
#     attaches to it, never the other way round.
#   - No port is published here. The adapter serves no listener; the host
#     invokes it as a oneshot and reads its exit status.
#   - The verified set and the audit log are written to a bind mount, not
#     published over the network.
#   - Promotion is NOT this network's business. See the container: it never
#     restarts, redeploys, or edits a Quadlet.
[Network]
NetworkName=ao-build-update
Driver=bridge
Internal=false
