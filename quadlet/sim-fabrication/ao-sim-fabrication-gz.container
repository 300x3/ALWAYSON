# /ALWAYSON/quadlet/sim-fabrication/ao-sim-fabrication-gz.container
# ALWAYS ON fabrication/facility simulation server — README §10.2 (ST-08) and
# the §10.2.1 baseline "3D world setup", tracked as WORK 000801.
#
# Per-domain separation required by README §10.2 (lines 1990-2003):
#   network           ao-sim-fabrication  Internal=true  10.89.5.0/24 (§18.6)
#   ROS domain ID     22                            (§20 line 892)
#   Gazebo partition  alwayson_fabrication_sim      (§20 line 892)
#   mounts            /ALWAYSON/GAZEBO (canonical, read-only)
#                     + /ALWAYSON/data/sim-fabrication/{gzhome,fuel,plugins,results}
#   result directory  /ALWAYSON/data/sim-fabrication/results  (§11.1 line 2066)
#   manifests         /ALWAYSON/data/sim-fabrication/manifests — Ed25519 signed
#                     with the ao-sim-fabrication key only; never a Corda
#                     client identity and no Corda connection (§10.2 line 1999)
#   log               /ALWAYSON/logs/sim-gz-server.log         (§16.3 line 3524)
#
# The world and its meshes resolve through GZ_SIM_RESOURCE_PATH (README §10.1
# line 1842, §10.2 line 2002) — never fetched or rewritten at runtime. The
# Gazebo subfolder is mounted at its own path so the models/factory_assets/
# meshes/ symlinks resolve in-container as they do on the host (§19.4 item 28
# records that subfolder as operator-confirmed; /ALWAYSON/GAZEBO).
# Holds no production data and never commands live machinery (§4.3).
[Unit]
Description=ALWAYS ON Fabrication Simulation Server (ao-sim-fabrication)
After=network-online.target
Wants=network-online.target

[Container]
# Digest-pinned 2026-10-01. This is a LOCALLY BUILT image, so the digest is the
# immutability record of the exact build that was validated - not an upstream
# release reference. Rebuilding gz-sim10-server makes this unit fail to start
# (by design: an unreviewed physics build must not silently take the place of a
# validated one). Re-pin deliberately after re-running the Gazebo validation.
Image=localhost/gz-sim10-server@sha256:55f8dbcf8decb0b97c6be7cf2fde8859b0fd05735c7a759df09a12e091933581
ContainerName=ao-sim-fabrication-gz
Network=ao-sim-fabrication.network
Volume=/ALWAYSON/GAZEBO:/ALWAYSON/GAZEBO:ro,Z
Volume=/ALWAYSON/data/sim-fabrication/gzhome:/gzhome:Z
Volume=/ALWAYSON/data/sim-fabrication/fuel:/gzfuel:Z
Volume=/ALWAYSON/data/sim-fabrication/plugins:/gzplugins:ro,Z
Volume=/ALWAYSON/data/sim-fabrication/results:/results:Z
# GZ_IP is the address this server ADVERTISES in gz-transport discovery, and
# it must be reachable by every container that bridges or views the world.
# It was 127.0.0.1, which only worked for ao-sim-fabrication-gui-gz because that
# container shares this container's network namespace. Measured consequence with
# the loopback value: from ao-sim-fabrication-foxglove,
#   gz topic -i -t /factory/camera/image
#     "No publishers on topic [/factory/camera/image]"
# i.e. the subscriber connected and the topic name was visible, but no image
# data ever arrived, so the local viewer received an advertised topic and zero
# frames. 127.0.0.1 means "me" to whichever container reads it, so a remote
# subscriber resolves the publisher to its own loopback.
#
# The server therefore needs a routable, STABLE address: discovery advertises
# this value, so it must not change on restart. PodmanArgs below pins the
# container to SERVER_IP. If the address is changed here it must be changed in
# both places, and 10.89.5.0/24 is registered in
# config/platform/network-cidrs.yaml as the ao-sim-fabrication domain.
Environment=GZ_IP=10.89.5.10
Environment=GZ_PARTITION=alwayson_fabrication_sim
Environment=GZ_VERSION=10
Environment=GZ_SIM_RESOURCE_PATH=/ALWAYSON/GAZEBO/models
Environment=GZ_SIM_SYSTEM_PLUGIN_PATH=/gzplugins
Environment=HOME=/gzhome
Environment=ROS_DOMAIN_ID=22
NoNewPrivileges=true
Exec=/ALWAYSON/GAZEBO/worlds/factory.world -r -s -v 4
# §16.3 line 3524 requires sim-gz-server.log while the server runs. Podman's
# journald driver (the systemd default) ignores --log-opt path, so the k8s-file
# driver is selected explicitly to write that file.
LogDriver=k8s-file
# --ip pins the container to the address advertised in GZ_IP above. Both must
# agree or gz-transport discovery advertises an address nothing is listening on.
PodmanArgs=--ip 10.89.5.10 --entrypoint /usr/libexec/gz/sim10/gz-sim-server --log-opt path=/ALWAYSON/logs/sim-gz-server.log

[Service]
Restart=on-failure
RestartSec=15
MemoryMax=8G
TimeoutStartSec=300

[Install]
WantedBy=default.target
