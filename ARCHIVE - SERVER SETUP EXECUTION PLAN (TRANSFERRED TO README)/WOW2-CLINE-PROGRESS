#!/usr/bin/env bash
# ALWAYS ON - mapping user-manager diagnosis + fix + service enable
set -Eeuo pipefail
IFS=$'\n\t'
LOG=/ALWAYSON/logs/installation/agent-install.log
exec >>"$LOG" 2>&1
echo "===== MAPPING FIX RUN $(date --iso-8601=seconds) ====="
MU=alwayson-mapping
MUID=$(id -u $MU)

echo "== linger before:"
loginctl show-user $MU -p Linger || true

echo "== ensure linger:"
loginctl enable-linger $MU && echo LINGER_SET

# give the user manager a moment to spawn
for i in $(seq 1 10); do
  [[ -d "/run/user/$MUID" ]] && break
  sleep 1
done
echo "== rundir:"; ls -ld /run/user/$MUID 2>&1

echo "== deployed units on disk:"
ls -la /home/$MU/.config/containers/systemd/mapping/

export HOME=/home/$MU
export XDG_RUNTIME_DIR=/run/user/$MUID

echo "== daemon-reload as $MU:"
runuser -u $MU -- env HOME=$HOME XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR systemctl --user daemon-reload && echo RELOAD_OK

echo "== units systemd sees:"
runuser -u $MU -- env HOME=$HOME XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR \
  systemctl --user list-unit-files 'ao-*' --no-legend || true

echo "== enabling services:"
for u in ao-webodm-db ao-webodm-broker ao-webodm-web ao-nodeodm ao-webodm-worker; do
  runuser -u $MU -- env HOME=$HOME XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR \
    systemctl --user enable --now "$u.service" 2>&1 || echo "ENABLE_FAIL: $u"
done

echo "== waiting up to 180s for stack health =="
ok=0
for i in $(seq 1 36); do
  sleep 5
  state=$(runuser -u $MU -- env HOME=$HOME XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR podman ps --format '{{.Names}} {{.Status}}' | sort)
  n=$(echo "$state" | grep -c . || true)
  echo "[poll $i] containers_up=$n"
  if (( n >= 5 )); then
    if runuser -u $MU -- env HOME=$HOME XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR \
         podman exec webapp curl -sf -o /dev/null http://localhost:8000/ 2>/dev/null; then
      ok=1; break
    fi
  fi
done

echo "== final state:"
runuser -u $MU -- env HOME=$HOME XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR podman ps -a --format 'table {{.Names}}\t{{.Status}}'

if (( ok )); then
  echo "WEBODM_DEPLOY_OK"
